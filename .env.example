# Copy to .env for local dev (`netlify dev` loads it). .env is gitignored and is
# NOT deployed — every variable here must also be added to the Netlify site
# (Site configuration → Environment variables), scoped to Functions, then redeployed.

# Neon Postgres connection string
DATABASE_URL=

# 32-byte key used to encrypt stored user API keys (AES-256-GCM).
# Must be exactly 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Shared secret checked by private/cors/cors.js
SEYONA_KEY=

# Neon Auth. Base URL is in Neon console → Auth → Configuration.
# Functions verify bearer JWTs against it; the browser signs in against it.
NEON_AUTH_BASE_URL=
# Optional. Defaults to <NEON_AUTH_BASE_URL>/.well-known/jwks.json
NEON_AUTH_JWKS_URL=
# Same value as NEON_AUTH_BASE_URL, exposed to the browser build by Vite
VITE_NEON_AUTH_URL=

# Point the app at `netlify dev` instead of the deployed functions
VITE_CURRENT_ENVIRONMENT=localenvironment

# OPTIONAL. The app is BYOK — the Anthropic key normally arrives from the
# onboarding form (X-Api-Key header). Set this only as a fallback for a
# single-user deployment. This is NOT the same thing as ENCRYPTION_KEY.
ANTHROPIC_API_KEY=
